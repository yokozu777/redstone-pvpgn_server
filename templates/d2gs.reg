REGEDIT4

[HKEY_LOCAL_MACHINE\SOFTWARE\D2Server\D2GS]
@="${D2GS_TITLE}"
"AutoUpdate"=dword:${D2GS_AUTOUPDATE_HEX}
"AutoUpdateUrl"="${D2GS_AUTOUPDATEURL}"
"AutoUpdateVer"=dword:${D2GS_AUTOUPDATEVER_HEX}
"AutoUpdateTimeout"=dword:${D2GS_AUTOUPDATETIMEOUT_HEX}
"D2CSIP"="${D2CS_IP}"
"D2CSPort"=dword:${D2CS_PORT_HEX}
"D2DBSIP"="${D2DBS_IP}"
"D2DBSPort"=dword:${D2DBS_PORT_HEX}
"MaxGames"=dword:${D2GS_MAXGAMES_HEX}
"MaxGameLife"=dword:${D2GS_MAXGAMELIFE_HEX}
"AdminPassword"="${D2GS_ADMINPASSWORD}"
"AdminPort"=dword:${D2GS_ADMINPORT_HEX}
"AdminTimeout"=dword:${D2GS_ADMINTIMEOUT_HEX}
"D2CSSecrect"="${D2GS_PASSWORD}"
"EnableNTMode"=dword:${D2GS_ENABLENTMODE_HEX}
"EnablePreCacheMode"=dword:${D2GS_ENABLEPRECACHEMODE_HEX}
"IdleSleep"=dword:${D2GS_IDLESLEEP_HEX}
"BusySleep"=dword:${D2GS_BUSYSLEEP_HEX}
"CharPendingTimeout"=dword:${D2GS_CHARPENDINGTIMEOUT_HEX}
"DebugNetPacket"=dword:${D2GS_DEBUGNETPACKET_HEX}
"DebugEventCallback"=dword:${D2GS_DEBUGEVENTCALLBACK_HEX}
"EnableGSLog"=dword:${D2GS_ENABLEGSLOG_HEX}
"EnableGELog"=dword:${D2GS_ENABLEGELOG_HEX}
"EnableGEMsg"=dword:${D2GS_ENABLEGEMSG_HEX}
"EnableGEPatch"=dword:${D2GS_ENABLEGEPATCH_HEX}
"IntervalReconnectD2CS"=dword:${D2GS_INTERVALRECONNECTD2CS_HEX}
"MultiCPUMask"=dword:${D2GS_MULTICPUMASK_HEX}
"MaxPreferUsers"=dword:${D2GS_MAXPREFERUSERS_HEX}
"MaxPacketPerSecond"=dword:${D2GS_MAXPACKETPERSECOND_HEX}
"ServerConfFile"="${D2GS_SERVERCONFFILE}"
"MOTD"="${D2GS_MOTD}"
