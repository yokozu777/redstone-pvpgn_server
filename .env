BNETD_XPCALCFILE="/pvpgn/etc/pvpgn/bnxpcalc.conf"
# ladderdir = LADDER_DIR
# command_groups_file
BNETD_COMMAND_GROUPS_FILE="/pvpgn/etc/pvpgn/command_groups.conf"
# tournament_file
BNETD_TOURNAMENT_FILE="/pvpgn/etc/pvpgn/tournament.conf"
# statusdir
