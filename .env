BNETD_TRANSFILE="/pvpgn/etc/pvpgn/address_translation.conf"
# customicons_file
BNETD_CUSTOMICONS_FILE="/pvpgn/etc/pvpgn/icons.conf"
# localizefile
BNETD_LOCALIZEFILE="common.xml"
# motdfile
BNETD_MOTDFILE="bnmotd.txt"
# motdw3file
BNETD_MOTDW3FILE="w3motd.txt"
# newsfile. The window text is built at startup into etc/i18n/news.txt.
# BNETD_NEWS is the part you write. \n is a line break. The build list is placed above it.
BNETD_NEWSFILE="news.txt"
BNETD_NEWS="Private server.\nCreate a character on the D2CS realm."
PVPGN_VERSION="1.99.8.0.0-rc1-PRO"
WINE_VERSION="11.22"
D2GS_ENGINE="1.13d"
D2GS_PATCH="1.14d"
D1GS_VERSION="DevXH 1.0.2"
# Docker socket used to read each image's build time. This machine's Docker Desktop socket.
DOCKER_SOCKET="/home/homer/.docker/desktop/docker.sock"
