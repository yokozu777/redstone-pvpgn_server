# The only file to edit.
# etc/bnetd.conf, d2cs.conf, d2dbs.conf, address_translation.conf, realm.conf,
# and conf/d2gs.reg are built from templates/ at startup. Edits to those six files are overwritten.
# versioncheck, channels, patches, and translations stay in their own files.

# Network. PUBLIC_IP is the address LAN clients use. DB_HOST must match MYSQL_HOSTNAME.
PUBLIC_IP="192.168.1.43"
SUBNET="172.16.230.0/24"
D2GS_HOSTNAME="d2gs"
D2GS_IP="172.16.230.60"
PVPGN_HOSTNAME="pvpgn"
PVPGN_IP="172.16.230.61"
D2DBS_HOSTNAME="d2dbs"
D2DBS_IP="172.16.230.62"
D2CS_HOSTNAME="d2cs"
D2CS_IP="172.16.230.63"
D1GS_HOSTNAME="d1gs"
D1GS_IP="172.16.230.64"
MYSQL_HOSTNAME="mysql"
MYSQL_IP="172.16.230.65"
DB_HOST="mysql"

# Ports. D2DBS_TRANSLATE_PORT is both sides of the d2dbs address-translation line. It is 6112, not the service port.
BNETD_PORT="6112"
D2CS_PORT="6113"
D2DBS_PORT="6114"
D2DBS_TRANSLATE_PORT="6112"
D2GS_PORT="4000"
D1GS_PORT="6115"
D1GS_NAME="d1gs"
W3ROUTE_PORT="6200"
W3ROUTE_BIND="0.0.0.0"

# Database. Changing DB_PASSWORD does not update an existing ./mysql directory. A password cannot contain ; " or a newline.
DB_NAME="pvpgn"
DB_USER="pvpgn"
DB_PASSWORD="pvpgnrocks"
DB_ROOT_PASSWORD="pvpgnrocks"
DB_TEMPLATE_UID="0"
DB_TABLE_PREFIX="pvpgn_"

# Realm and the D2GS password. D2GS_PASSWORD is shared by d2cs and the registry.
REALM_NAME="D2CS"
REALM_DESCRIPTION="PvPGN Closed Realm"
D2GS_PASSWORD="pvpgnrocks"

# Images
BNETD_IMAGE="bnetd:latest"
MYSQL_IMAGE="mariadb:12.3"
D2GS_IMAGE="d2srv:latest"
D1GS_IMAGE="d1gs:latest"

# Shared character and ladder directories
CHARSAVE_DIR="/pvpgn/var/pvpgn/charsave"
CHARINFO_DIR="/pvpgn/var/pvpgn/charinfo"
LADDER_DIR="/pvpgn/var/pvpgn/ladders"
BAK_CHARSAVE_DIR="/pvpgn/var/pvpgn/bak/charsave"
BAK_CHARINFO_DIR="/pvpgn/var/pvpgn/bak/charinfo"

